# resume_tex: keep only the active resume source + its class file; ignore old
# drafts (cv_new_v1.tex, main.tex, template.tex), build artifacts (cv_new.pdf,
# *.aux/*.log/*.out), unused assets (photo.jpg, *.bib, sections/), and the zip.
resume_tex/*
!resume_tex/cv_new.tex
!resume_tex/altacv.cls
.claude/skills/*

